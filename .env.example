# Copy to .env for local work. In Coolify, set these as environment variables / secrets.
SECRET_KEY=change-me
DEBUG=True
GEMINI_API_KEY=
# Set AI_BACKEND=names.ai.stub.StubAI to run without calling Gemini.
# ALLOWED_HOSTS=names.example.com
# CSRF_TRUSTED_ORIGINS=https://names.example.com
# DATABASE_URL=postgres://user:password@host:5432/naamadeva
# REDIS_URL=redis://default:password@host:6379/0
# Without these, sign-up codes print to the console instead of being emailed.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Naamadeva <no-reply@example.com>
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Google sign-in. The button appears once GOOGLE_CLIENT_ID is set. See README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Soota's engine gateway, on the Coolify network. The birth star panel appears once SOOTA_API_URL is set. See README.
# SOOTA_API_URL=http://soota-engine-gateway:8000
# SOOTA_API_KEY=sek_...
# Published in the legal pages. They show a visible placeholder until these are set.
# LEGAL_ENTITY_NAME=
# LEGAL_ADDRESS=
# LEGAL_JURISDICTION_CITY=
# GRIEVANCE_OFFICER_NAME=
# GRIEVANCE_EMAIL=
